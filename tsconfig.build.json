{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "declaration": true,
    "stripInternal": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.reference.ts", "src/testHelpers.ts", "node_modules"]
}
